public class Main {

    public static Estudante[] aprovados(Estudante[] estudantes) {

        int quantidadeAprovados = 0;

        for (Estudante estudante : estudantes) {
            if (estudante.calculaMedia() >= 6) {
                quantidadeAprovados++;
            }
        }

        if (quantidadeAprovados == 0) {
            return null;
        }

        Estudante[] estudantesAprovados = new Estudante[quantidadeAprovados];

        int posicao = 0;

        for (Estudante estudante : estudantes) {
            if (estudante.calculaMedia() >= 6) {
                estudantesAprovados[posicao] = estudante;
                posicao++;
            }
        }

        return estudantesAprovados;
    }

    public static void main(String[] args) {

        Estudante estudante1 = new Estudante("Breno");
        Estudante estudante2 = new Estudante("Carlos");
        Estudante estudante3 = new Estudante("Lucas");

        Estudante[] estudantes = {
            estudante1,
            estudante2,
            estudante3
        };

    }

}
